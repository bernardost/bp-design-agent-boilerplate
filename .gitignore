.DS_Store
__pycache__/
*.pyc
.venv/
venv/

# Generated projections — rebuild with `python3 brain/feed.py` / `brief.py` / `spread.py`
brain/feed.html
brain/brief.html
brain/explorations/*.html
brain/moodboards/*.html
brain/playground/index.html
brain/playground/*/versions.js

# If the project acquires confidential source material, keep it out from day one,
# e.g.:
# context/client-context/
brain/brain.canvas

# Screenshot and trace dumps from browser tooling — an agent that renders the work leaves
# these behind, and they are not the record.
.playwright-mcp/

# Product repos cloned into the workspace. Each keeps its own git history and its own remote;
# tracked from here, git would record a broken pointer instead of the files.
projects/

# Generation keys — dev-only, tightly capped, and they never ship in a deliverable.
.env.agents
